#!/bin/bash
# Configuración automática para sol-pagos en Codespaces

# 1. Instalar Solana CLI
sh -c "$(curl -sSfL https://release.solana.com/v1.18.4/install)"
export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"

# 2. Instalar Anchor (avm)
cargo install --git https://github.com/coral-xyz/anchor avm --locked --force
/usr/local/cargo/bin/avm install latest
/usr/local/cargo/bin/avm use latest

# 3. Forzar Node 20 para evitar errores de Next.js/Astro
nvm install 20
nvm use 20

# 4. Instalar dependencias del proyecto
npm install

# 5. Generar wallet de desarrollo si no existe
if [ ! -f ~/.config/solana/id.json ]; then
    /home/vscode/.local/share/solana/install/active_release/bin/solana-keygen new --no-passphrase
fi

echo "¡Entorno listo para la Hackathon!"